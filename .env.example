# Asset Oracle frontend configuration
# The active 2-of-3 Enugu testnet manager is pinned in src/contracts/assetOracle.ts.
# Public Reown Cloud project ID used by RainbowKit / WalletConnect.
VITE_REOWN_PROJECT_ID=

# Optional API endpoint override
VITE_API_URL=https://asset-oracle-backend.onrender.com
# Comma-separated public admin wallet addresses
VITE_ADMIN_WALLET_ADDRESSES=

# Verified RWA token contract on Asset Chain Enugu testnet (required for portfolio balance display)
VITE_TESTNET_RWA_ADDRESS=
